{
  "name": "@healthbridge/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=.env src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "start": "bun dist/index.js",
    "seed": "bun --env-file=.env src/scripts/seed-doctors.ts",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@healthbridge/auth": "workspace:*",
    "@healthbridge/db": "workspace:*",
    "@healthbridge/image": "workspace:*",
    "@healthbridge/types": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.4.0",
    "express": "^5.2.1",
    "file-type": "^22.0.2",
    "googleapis": "^174.0.1",
    "multer": "^2.2.0",
    "razorpay": "^2.9.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@healthbridge/typescript-config": "workspace:*",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "mongodb-memory-server": "^11.2.0",
    "typescript": "~6.0.2"
  },
  "peerDependencies": {
    "typescript": "~6.0.2"
  }
}
