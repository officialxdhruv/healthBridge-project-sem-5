{
  "name": "healthbridge",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "turbo run dev --ui tui",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d mongo",
    "docker:server": "docker compose up -d backend",
    "docker:web": "docker compose up -d web"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "latest"
  },
  "peerDependencies": {
    "typescript": "latest"
  },
  "packageManager": "bun@1.4.2"
}
