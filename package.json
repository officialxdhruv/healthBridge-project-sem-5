{
  "name": "healthbridge",
  "module": "index.ts",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --ui tui",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "biome check --write .",
    "check": "biome check --write .",
    "lint:fix": "biome lint --write .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:db": "docker compose up -d mongo",
    "docker:server": "docker compose up -d backend",
    "docker:web": "docker compose up -d web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/bun": "latest",
    "turbo": "^2.9.6"
  },
  "peerDependencies": {
    "typescript": "~6.0.2"
  }
}
