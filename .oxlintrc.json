{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": [
    "@shadcn/lint"
  ],
  "settings": {
    "shadcn": {
      "ui": "@healthbridge/ui/components"
    }
  },
  "rules": {
    "shadcn/no-restyle": [
      "error",
      {
        "allow": [
          "layout"
        ]
      }
    ]
  },
  "ignorePatterns": [
    "temp",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/public",
    "apps/web/src/assets"
  ],
  "overrides": [
    {
      "files": [
        "packages/ui/src/components/**"
      ],
      "rules": {
        "shadcn/no-restyle": "off"
      }
    }
  ]
}